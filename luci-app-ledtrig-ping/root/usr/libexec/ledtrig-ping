#!/bin/sh
# LED trigger: ping target. Reads UCI system.@led[], for each with trigger=ping
# sets LED to "none" and drives brightness by pinging the configured target.

LEDS_PATH="/sys/class/leds"
DEFAULT_INTERVAL=5
MIN_INTERVAL=1
TAG="ledtrig-ping"

log_err()  { logger -t "$TAG" -p daemon.err  "$1"; }
log_info() { logger -t "$TAG" -p daemon.info "$1"; }
log_dbg()  { logger -t "$TAG" -p daemon.debug "$1"; }

log_info "Servicio iniciado (PID $$)"

if [ ! -d "$LEDS_PATH" ]; then
	log_err "No existe $LEDS_PATH; el kernel no expone LEDs via sysfs en este dispositivo"
	exit 1
fi

STATE_DIR="/tmp/ledtrig-ping.state"
mkdir -p "$STATE_DIR"

while true; do
	led_found=0
	next_sleep=""

	for sec in $(uci show system 2>/dev/null | sed -n 's/^system\.\([^.=]*\)\.trigger=.*/\1/p'); do
		trigger=$(uci -q get system.$sec.trigger 2>/dev/null)
		[ "$trigger" != "ping" ] && continue

		led_found=1

		sysfs=$(uci -q get system.$sec.sysfs 2>/dev/null)
		target=$(uci -q get system.$sec.target 2>/dev/null)
		invert=$(uci -q get system.$sec.invert 2>/dev/null)
		interval=$(uci -q get system.$sec.interval 2>/dev/null)
		invert=${invert:-0}

		if [ -z "$sysfs" ]; then
			log_err "Sección $sec: falta el parámetro 'sysfs' (nombre del LED)"
			continue
		fi

		if [ -z "$target" ]; then
			log_err "Sección $sec: falta el parámetro 'target' (host a hacer ping)"
			continue
		fi

		if ! echo "$interval" | grep -q '^[0-9]\+$' || [ "$interval" -lt "$MIN_INTERVAL" ]; then
			[ -n "$interval" ] && log_err "Sección $sec: interval '$interval' inválido, uso ${DEFAULT_INTERVAL}s"
			interval=$DEFAULT_INTERVAL
		fi

		if [ ! -d "$LEDS_PATH/$sysfs" ]; then
			log_err "Sección $sec: no existe $LEDS_PATH/$sysfs. LEDs disponibles: $(ls "$LEDS_PATH" 2>/dev/null | tr '\n' ' ')"
			continue
		fi

		# Set trigger to none (manual control)
		if ! echo "none" > "$LEDS_PATH/$sysfs/trigger" 2>/dev/null; then
			log_err "Sección $sec: no se pudo escribir 'none' en $LEDS_PATH/$sysfs/trigger (¿permiso denegado o trigger fijo por el driver/hardware?)"
			continue
		fi

		# Perform ping test
		if ping -c 1 -W 3 -q "$target" >/dev/null 2>&1; then
			reachable=1
		else
			reachable=0
		fi
		log_dbg "Sección $sec: ping a $target -> $([ "$reachable" = 1 ] && echo alcanzable || echo inalcanzable)"

		if [ "$reachable" = 1 ]; then
			[ "$invert" = "1" ] && value=0 || value=255
		else
			[ "$invert" = "1" ] && value=255 || value=0
		fi

		if echo "$value" > "$LEDS_PATH/$sysfs/brightness" 2>/dev/null; then
			write_ok=1
		else
			write_ok=0
			log_err "Sección $sec: no se pudo escribir brightness=$value en $LEDS_PATH/$sysfs/brightness (¿permiso denegado o LED de solo lectura?)"
		fi

		state_file="$STATE_DIR/$sec"
		prev_value=$(cat "$state_file" 2>/dev/null)
		if [ "$write_ok" = 1 ] && [ "$value" != "$prev_value" ]; then
			log_info "Sección $sec: LED $sysfs -> brightness=$value (target=$target, reachable=$reachable, invert=$invert)"
			echo "$value" > "$state_file"
		fi

		# Cada LED de ping conserva su propio intervalo: dormimos el
		# mínimo de todos para no retrasar la comprobación de ninguno.
		if [ -z "$next_sleep" ] || [ "$interval" -lt "$next_sleep" ]; then
			next_sleep=$interval
		fi
	done

	if [ $led_found -eq 0 ]; then
		log_info "No hay ninguna sección system.@led[] con trigger='ping' configurada"
	fi

	sleep "${next_sleep:-$DEFAULT_INTERVAL}"
done
